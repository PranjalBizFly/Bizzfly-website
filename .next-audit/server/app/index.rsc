29:["$","section",null,{"id":"stages","className":"Section_section__vCyY6 Section_lg__MMJQv Section_surface__GHRPS","children":["$","div",null,{"className":"container container--default","children":[["$","$L49",null,{"className":"Sections_headerSplit__CT5lM","children":[["$","div",null,{"className":"Sections_header__Q_KpY","children":[["$","p",null,{"className":"t-eyebrow","children":"09 / Where you are"}],["$","h2",null,{"id":"$undefined","className":"t-h2 Sections_headerTitle__qJ_zD","children":"The right work depends on the constraint you actually have"}]]}],["$","p",null,{"className":"t-body-lg  Sections_headerLead__EvBgC","children":"Businesses move between these. The mistake is buying the work that suits the stage you wish you were at."}]]}],["$","$L5a",null,{"images":{"Start":{"id":"service-corporate-websites","src":"/images/services/service-corporate-websites.webp","alt":"Professional Indian digital enterprise consultant designing corporate web platforms at workstation","topic":"Corporate Websites","category":"services","type":"human","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"},"Grow":{"id":"service-seo","src":"/images/services/service-seo-strategy.webp","alt":"Indian technical SEO specialist analysing search performance metrics and indexing status on computer at desk","topic":"Search Engine Optimisation","category":"services","type":"human","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"},"Scale":{"id":"service-workflow-automation","src":"/images/services/service-workflow-automation.webp","alt":"Indian process systems consultant in clean dress shirt reviewing automated operational workflows","topic":"Workflow Automation","category":"services","type":"human","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"},"Transform":{"id":"service-ai-consulting","src":"/images/services/service-ai-consulting.webp","alt":"Professional Indian enterprise AI strategy consultants advising executive leadership in modern glass conference room","topic":"AI Consulting","category":"services","type":"human","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"}}}]]}]}]
2a:["$","section",null,{"id":"industries","className":"Section_section__vCyY6 Section_lg__MMJQv","children":["$","div",null,{"className":"container container--default","children":[["$","$L49",null,{"className":"Sections_headerSplit__CT5lM","children":[["$","div",null,{"className":"Sections_header__Q_KpY","children":[["$","p",null,{"className":"t-eyebrow","children":"10 / Industries"}],["$","h2",null,{"id":"$undefined","className":"t-h2 Sections_headerTitle__qJ_zD","children":"Context matters more than templates"}]]}],["$","p",null,{"className":"t-body-lg  Sections_headerLead__EvBgC","children":"A manufacturer and an education group have almost nothing in common except that both are hard to find. We publish a sector page only where we can name that sector's real problems in its own vocabulary."}]]}],["$","$L5b",null,{"entries":[{"index":"01","title":"Manufacturing","description":"Buyers search by material, tolerance, capacity or application. Most manufacturer sites are organised around company structure instead, so they never match the query.","href":"/industries/manufacturing/","image":{"id":"industry-manufacturing","src":"/images/industries/industry-manufacturing.webp","alt":"Indian industrial engineer managing manufacturing operations and CNC machinery in a metal fabrication facility","topic":"Manufacturing","category":"industries","type":"human","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"}},{"index":"02","title":"Real Estate","description":"Leads are shared with three competitors and priced by the platform. There is no compounding return on the spend.","href":"/industries/real-estate/","image":{"id":"industry-real-estate","src":"/images/industries/industry-real-estate.webp","alt":"Modern commercial real estate architecture showcasing property development projects","topic":"Real Estate","category":"industries","type":"business","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"}},{"index":"03","title":"Education & EdTech","description":"Course and eligibility searches return listing sites first. Prospective students form a shortlist before reaching the institution's own site.","href":"/industries/education/","image":{"id":"industry-education","src":"/images/industries/industry-education.webp","alt":"Professional Indian higher education administrators and educators collaborating in modern academic setting","topic":"Education","category":"industries","type":"human","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"}},{"index":"04","title":"Professional Services","description":"Growth is capped by the size of the partner address book, because nothing brings in demand independently.","href":"/industries/professional-services/","image":{"id":"industry-professional-services","src":"/images/industries/industry-professional-services.webp","alt":"Professional advisors discussing client advisory engagement in corporate meeting space","topic":"Professional Services","category":"industries","type":"human","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"}},{"index":"05","title":"SaaS","description":"Buyers search the problem before they search a product. Sites built only around features never enter the research stage where the shortlist is formed.","href":"/industries/saas/","image":{"id":"industry-saas","src":"/images/industries/industry-saas.webp","alt":"Indian SaaS technology entrepreneur reviewing user growth metrics and subscription churn analytics on laptop","topic":"SaaS","category":"industries","type":"human","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"}},{"index":"06","title":"Healthcare","description":"Sites describe services in clinical language while patients search in everyday words about cost, waiting time, preparation and what will actually happen.","href":"/industries/healthcare/","image":{"id":"industry-healthcare","src":"/images/industries/industry-healthcare.webp","alt":"Healthcare professionals reviewing clinical records on digital tablet in medical setting","topic":"Healthcare","category":"industries","type":"human","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"}},{"index":"07","title":"Financial Services","description":"Legal review strips content until it is accurate and useless. The result ranks poorly and answers nothing a customer actually asked.","href":"/industries/financial-services/","image":{"id":"industry-financial-services","src":"/images/industries/industry-financial-services.webp","alt":"Finance professional reviewing investment portfolios and banking analytics on dual screens","topic":"Financial Services","category":"industries","type":"editorial","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"}},{"index":"08","title":"E-commerce & Retail","description":"Filter combinations produce thousands of near-identical URLs, spending crawl effort on pages that should never have been indexable.","href":"/industries/ecommerce/","image":{"id":"industry-ecommerce","src":"/images/industries/industry-ecommerce.webp","alt":"Modern fulfillment warehouse and online retail distribution operations","topic":"E-commerce","category":"industries","type":"business","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"}},{"index":"09","title":"Logistics & Supply Chain","description":"Customers call or email for information that exists in a system nobody has exposed to them, and staff act as a lookup service.","href":"/industries/logistics/","image":{"id":"industry-logistics","src":"/images/industries/industry-logistics.webp","alt":"Logistics supply chain manager coordinating freight shipments and warehouse storage","topic":"Logistics","category":"industries","type":"business","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"}},{"index":"10","title":"IT Services","description":"Identical service lists and the same adjectives leave a buyer with nothing to compare except price.","href":"/industries/it-services/","image":{"id":"industry-it-services","src":"/images/industries/industry-it-services.webp","alt":"IT services and systems support team collaborating in networked enterprise operations center","topic":"IT Services","category":"industries","type":"human","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"}},{"index":"11","title":"Hospitality","description":"Outdated hours, missing facilities and inconsistent details across platforms cost bookings before the site is ever reached.","href":"/industries/hospitality/","image":{"id":"industry-hospitality","src":"/images/industries/industry-hospitality.webp","alt":"Boutique luxury hotel lobby highlighting digital guest booking and hospitality services","topic":"Hospitality","category":"industries","type":"editorial","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"}},{"index":"12","title":"Startups","description":"A little of everything produces nothing measurable, and the team concludes that none of it works.","href":"/industries/startups/","image":{"id":"industry-startups","src":"/images/industries/industry-startups.webp","alt":"Professional Indian tech startup founders and engineers collaborating in a modern agile innovation hub","topic":"Startups","category":"industries","type":"human","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"}},{"index":"13","title":"Technology","description":"Category vocabulary converges. When six vendors all promise to be scalable, secure and intelligent, none of those words carry information, and the buyer falls back on price or on whoever a colleague recommended.","href":"/industries/technology/","image":{"id":"industry-technology","src":"/images/industries/industry-technology.webp","alt":"Semiconductor microchip and advanced electronics engineering hardware","topic":"Technology Sector","category":"industries","type":"technology","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"}},{"index":"14","title":"Automotive","description":"Group sites frequently rank a single branch for everything, so nearby locations lose searches happening on their doorstep. This is usually a structural problem with location pages and profiles rather than a competitive one.","href":"/industries/automotive/","image":{"id":"industry-automotive","src":"/images/industries/industry-automotive.webp","alt":"Modern automotive engineering laboratory developing connected vehicle systems","topic":"Automotive","category":"industries","type":"business","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"}},{"index":"15","title":"Construction","description":"Without qualification at the point of enquiry, the estimator's queue fills with projects outside the scope, budget or geography the business actually wants.","href":"/industries/construction/","image":{"id":"industry-construction","src":"/images/industries/industry-construction.webp","alt":"Civil engineer inspecting commercial building construction blueprints and structural site work","topic":"Construction","category":"industries","type":"human","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"}},{"index":"16","title":"Legal Services","description":"Fee earners answer the same questions constantly, and almost none of it reaches the website. That material is the firm's most credible asset and its cheapest source of visibility.","href":"/industries/legal-services/","image":{"id":"industry-legal-services","src":"/images/industries/industry-legal-services.webp","alt":"Legal counsel library symbolizing corporate legal practice, compliance, and governance","topic":"Legal Services","category":"industries","type":"editorial","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"}},{"index":"17","title":"Accounting & Advisory","description":"Identity checks, engagement letters, document collection and system setup consume the same weeks that are already the practice's busiest.","href":"/industries/accounting/","image":{"id":"industry-accounting","src":"/images/industries/industry-accounting.webp","alt":"Chartered accountant auditing corporate financial statements and tax filings","topic":"Accounting","category":"industries","type":"process","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"}},{"index":"18","title":"Recruitment & Staffing","description":"Client-facing and candidate-facing content compete in the same navigation, so both audiences read material written for the other before finding their own.","href":"/industries/recruitment/","image":{"id":"industry-recruitment","src":"/images/industries/industry-recruitment.webp","alt":"Talent acquisition partner conducting interview consultation with career candidate","topic":"Recruitment","category":"industries","type":"human","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"}},{"index":"19","title":"Energy & Utilities","description":"Specifiers need specification. Marketing copy pitched at a general reader signals that the supplier does not understand who is evaluating them.","href":"/industries/energy/","image":{"id":"industry-energy","src":"/images/industries/industry-energy.webp","alt":"Renewable solar and wind energy infrastructure powering sustainable electrical grid","topic":"Energy","category":"industries","type":"editorial","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"}},{"index":"20","title":"Travel & Tourism","description":"Aggregators invest heavily in exactly the queries the operator should own, and often present the operator's inventory better than the operator does.","href":"/industries/travel/","image":{"id":"industry-travel","src":"/images/industries/industry-travel.webp","alt":"Travel technology platform user booking flight and itinerary routes on mobile device","topic":"Travel","category":"industries","type":"editorial","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"}},{"index":"21","title":"Non-Profit & Social Impact","description":"Fundraising material dominates while the people the organisation exists to help have to navigate around it to find support.","href":"/industries/nonprofit/","image":{"id":"industry-nonprofit","src":"/images/industries/industry-nonprofit.webp","alt":"Professional Indian corporate CSR and non-profit leaders collaborating in a modern boardroom and reviewing digital social impact metrics on a presentation screen","topic":"Nonprofit","category":"industries","type":"human","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"}},{"index":"22","title":"Media & Publishing","description":"Impressions hold while clicks fall. The article still ranks and still gets read — inside someone else's answer, with no session recorded.","href":"/industries/media/","image":{"id":"industry-media","src":"/images/industries/industry-media.webp","alt":"Digital publishing editorial workspace with newspapers and digital journalism content","topic":"Media","category":"industries","type":"editorial","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"}},{"index":"23","title":"Agriculture & Agritech","description":"Records written in the field are entered into systems later, introducing delay and transcription errors into exactly the records that have to be defensible.","href":"/industries/agriculture/","image":{"id":"industry-agriculture","src":"/images/industries/industry-agriculture.webp","alt":"Agricultural technologist monitoring automated crop irrigation and yield analytics","topic":"Agriculture","category":"industries","type":"business","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"}},{"index":"24","title":"B2B Services","description":"When referral slows, there is no alternative pipeline and the response is usually a burst of outbound activity that produces poorer-fit clients.","href":"/industries/b2b-services/","image":{"id":"industry-b2b-services","src":"/images/industries/industry-b2b-services.webp","alt":"Professional Indian B2B leadership executive in corporate office","topic":"B2B Services","category":"industries","type":"human","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"}},{"index":"25","title":"D2C Brands","description":"Growth funded by paid media stops working when the cost per acquisition approaches the margin, and there is no owned channel to fall back on.","href":"/industries/d2c-brands/","image":{"id":"industry-d2c-brands","src":"/images/industries/industry-d2c-brands.webp","alt":"Contemporary retail boutique showcasing direct-to-consumer lifestyle merchandise","topic":"D2C Brands","category":"industries","type":"editorial","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"}},{"index":"26","title":"Small & Medium Enterprises","description":"Responsibility sits with someone who has another full-time job, so activity is sporadic and nothing compounds.","href":"/industries/smes/","image":{"id":"industry-smes","src":"/images/industries/industry-smes.webp","alt":"Professional Indian SME business founders and directors analyzing company growth analytics and financial performance dashboards in a modern Pune tech office","topic":"SMEs","category":"industries","type":"human","aspectRatio":"3:2","width":1200,"height":800,"usage":"editorial"}}],"label":"Industries we publish for"}],"$L5c"]}]}]
