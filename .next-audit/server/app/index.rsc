26:["$","section",null,{"id":"visibility","className":"Section_section__vCyY6 Section_lg__MMJQv is-tint","children":["$","div",null,{"className":"container container--default","children":[["$","$L49",null,{"className":"Sections_headerSplit__CT5lM","children":[["$","div",null,{"className":"Sections_header__Q_KpY","children":[["$","p",null,{"className":"t-eyebrow","children":"06 / Discoverability"}],["$","h2",null,{"id":"$undefined","className":"t-h2 Sections_headerTitle__qJ_zD","children":"SEO was one surface. Now there are five."}]]}],["$","p",null,{"className":"t-body-lg  Sections_headerLead__EvBgC","children":"These are not five names for the same work. Each layer describes a different retrieval mechanism, and a business can be strong on one and invisible on the next."}]]}],["$","$L54",null,{"label":"Search and AI visibility layers","items":[{"code":"SEO","surface":"Ranked results","name":"Search Engine Optimisation","question":"Do we appear in the list?","description":"The original surface, and still the largest. A ranked list of links where position determines whether anyone sees you.","facts":[{"label":"How it is won","value":"Crawling, indexing and ranking. Won through technical health, relevance to a query, and authority."}],"href":"/services/seo/"},{"code":"AEO","surface":"Direct answers","name":"Answer Engine Optimisation","question":"Are we quoted as the answer?","description":"Featured snippets and direct answers, where a system lifts a passage from a page and shows it instead of the list.","facts":[{"label":"How it is won","value":"Extraction. Rewards a complete answer stated in the first few sentences, in language that survives being pulled out of context."}],"href":"/services/answer-engine-optimisation/"},{"code":"GEO","surface":"AI-generated answers","name":"Generative Engine Optimisation","question":"Are we cited as a source?","description":"ChatGPT, Perplexity, Gemini and AI Overviews compose an answer from several sources and attribute some of them.","facts":[{"label":"How it is won","value":"Retrieval and synthesis. Rewards an unambiguous brand entity, checkable claims and content a model can attribute confidently."}],"href":"/services/generative-engine-optimisation/"},{"code":"AIO","surface":"Machine readability","name":"AI Optimisation","question":"Can a machine read us at all?","description":"The layer underneath the others. If AI crawlers cannot render or parse your site, nothing above this line is achievable.","facts":[{"label":"How it is won","value":"Server-rendered HTML, structured data anchored to one entity, and crawler access that is deliberate rather than accidental."}],"href":"/services/ai-optimisation/"},{"code":"SXO","surface":"After the click","name":"Search Experience Optimisation","question":"Do we convert what we win?","description":"Being found is not being chosen. This layer covers what happens between the click and the enquiry.","facts":[{"label":"How it is won","value":"Intent matching, page experience and conversion path work applied to the pages search actually sends people to."}],"href":"/services/search-experience-optimisation/"}]}]]}]}]
