a:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"@id\":\"https://bizzfly.com/#organization\",\"name\":\"BizzFly\",\"url\":\"https://bizzfly.com\",\"description\":\"BizzFly helps businesses get found across search and AI platforms — then builds the websites, software and automation that turn discovery into revenue.\",\"founder\":{\"@type\":\"Person\",\"name\":\"Rahul Jadhav\"},\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"2nd Floor, Shri Nivas Towers, Above Baramati Bank\",\"addressLocality\":\"Pune\",\"addressRegion\":\"Maharashtra\",\"postalCode\":\"411043\",\"addressCountry\":\"IN\"},\"contactPoint\":{\"@type\":\"ContactPoint\",\"telephone\":\"+91 91 9815 9815\",\"email\":\"sales@BizzFly.com\",\"contactType\":\"sales\",\"areaServed\":\"IN\",\"availableLanguage\":[\"en\"]}}"}}]
b:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"@id\":\"https://bizzfly.com/#website\",\"url\":\"https://bizzfly.com\",\"name\":\"BizzFly\",\"publisher\":{\"@id\":\"https://bizzfly.com/#organization\"},\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https://bizzfly.com/search/?q={search_term_string}\"},\"query-input\":\"required name=search_term_string\"}}"}}]
1e:T85a,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What does BizzFly actually do?","acceptedAnswer":{"@type":"Answer","text":"Four connected things: search and AI visibility, websites and digital experience, software and automation, and the analytics that measure them. Most engagements start in one and touch a second, because visibility and the ability to serve demand are usually the same problem."}},{"@type":"Question","name":"How does an engagement start?","acceptedAnswer":{"@type":"Answer","text":"Almost always with a fixed-scope diagnostic rather than a retainer. It establishes which constraint is actually binding, produces a written diagnosis you keep either way, and lets both sides judge the relationship before committing further."}},{"@type":"Question","name":"How long before we see results?","acceptedAnswer":{"@type":"Answer","text":"Technical work can show measurable movement in indexing and impressions within about eight to twelve weeks. Content and credibility work usually takes longer to show commercially. Automation and software show a result as soon as the first process is in production, typically four to twelve weeks."}},{"@type":"Question","name":"Do you guarantee rankings or AI citations?","acceptedAnswer":{"@type":"Answer","text":"No, and anyone who does is describing something they do not control. What we commit to is removing the reasons a system would not rank or cite you, and reporting honestly on whether it moved."}},{"@type":"Question","name":"Who owns the code and the accounts?","acceptedAnswer":{"@type":"Answer","text":"You do, from the start. Code lives in your repositories and infrastructure in your accounts. Ownership arranged at the end of a project is ownership you negotiate for at the worst possible moment."}},{"@type":"Question","name":"Do you work with small businesses?","acceptedAnswer":{"@type":"Answer","text":"Yes, though the shape differs. Smaller engagements are usually a single focused project rather than an ongoing programme, because a programme needs enough scope each month to be worth the overhead of running one."}}]}c:["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"@id\":\"https://bizzfly.com/#webpage\",\"url\":\"https://bizzfly.com\",\"name\":\"BizzFly — Digital Growth, AI & Automation\",\"description\":\"BizzFly helps businesses get found across search and AI platforms — then builds the websites, software and automation that turn discovery into revenue.\",\"isPartOf\":{\"@id\":\"https://bizzfly.com/#website\"},\"about\":{\"@id\":\"https://bizzfly.com/#organization\"}}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1e"}}],[["$","section",null,{"className":"CinematicHero_hero__r8hDz CinematicHero_bleedRight__F3vWN is-inverse","children":[["$","div",null,{"className":"CinematicHero_media__3L0mJ","children":[["$","$L17",null,{"src":"/images/home/hero-growth-ai-team.webp","alt":"BizzFly digital growth and engineering team collaborating around shared monitors in a modern technology office","width":1200,"height":675,"priority":true,"sizes":"100vw","className":"CinematicHero_image__VHEwa"}],["$","span",null,{"className":"CinematicHero_scrim__eiFDQ","aria-hidden":"true"}]]}],["$","div",null,{"className":"container container--default CinematicHero_container__2xIaZ","children":[null,"$L1f","$L20"]}]]}],"$L21"],"$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e",null,"$L2f","$L30","$L31","$L32","$L33"],["$L34","$L35","$L36","$L37","$L38"],"$L39"]}]
