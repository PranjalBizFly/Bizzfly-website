0 0 24 24","width":"0.85rem","height":"0.85rem","className":"TrustStandard_glyph__WylJo","fill":"currentColor","focusable":"false","aria-hidden":"true","children":["$","path",null,{"d":"M12 0 Q13.4 8.6 21 12 Q13.4 15.4 12 24 Q10.6 15.4 3 12 Q10.6 8.6 12 0 Z"}]}],["$","h3",null,{"className":"TrustStandard_title__AQCbO","children":"No client named without written approval"}],["$","p",null,{"className":"TrustStandard_body__nifJW","children":"Case studies are published only after the client has approved the wording and the attribution in writing. Where they prefer not to be named, we describe the business honestly instead of inventing one."}]]}],["$","$L4b","03",{"as":"li","index":2,"className":"TrustStandard_item__NYE_d","children":[["$","span",null,{"className":"TrustStandard_index__wuQfE","aria-hidden":"true","children":"03"}],["$","svg",null,{"viewBox":"0 0 24 24","width":"0.85rem","height":"0.85rem","className":"TrustStandard_glyph__WylJo","fill":"currentColor","focusable":"false","aria-hidden":"true","children":["$","path",null,{"d":"M12 0 Q13.4 8.6 21 12 Q13.4 15.4 12 24 Q10.6 15.4 3 12 Q10.6 8.6 12 0 Z"}]}],["$","h3",null,{"className":"TrustStandard_title__AQCbO","children":"Every case study says what went wrong"}],["$","p",null,{"className":"TrustStandard_body__nifJW","children":"A project retrospective with no difficult section is a sales document. Ours name the things that proved harder than expected, because that is the part worth reading."}]]}]]}],["$","p",null,{"className":"TrustStandard_note__TFoOo","children":["We would rather show you nothing than show you something invented. Ask us directly about work in your sector and we will tell you what we have done, and where we have not worked before."," ",["$","$L15",null,{"href":"/case-studies/","className":"TrustStandard_noteLink__HHmLa","children":"How we publish client work"}]]}]]}]]}]}]
2f:["$","section",null,{"id":"founder","className":"Section_section__vCyY6 Section_lg__MMJQv","children":["$","div",null,{"className":"container container--default","children":["$","div",null,{"className":"FounderNote_wrapper__q4Nkf","data-has-image":true,"children":[["$","$L49",null,{"direction":"right","className":"FounderNote_figure__zSr5w","children":[["$","div",null,{"className":"FounderNote_frame__Nl06I","children":["$","$L17",null,{"src":"/images/home/founder-rahul-jadhav.webp","alt":"Rahul Jadhav, Founder of BizzFly","width":666,"height":663,"loading":"lazy","sizes":"(min-width: 1024px) 46vw, 100vw","className":"FounderNote_image__z9lO_"}]}],["$","div",null,{"className":"FounderNote_signature__egfuc","children":[["$","p",null,{"className":"FounderNote_name__jI0Ll","children":"Rahul Jadhav"}],["$","p",null,{"className":"FounderNote_role__NlAgc","children":["Founder",["$","span",null,{"className":"FounderNote_separator__IaSB5","aria-hidden":"true","children":"/"}],"Pune, India"]}]]}]]}],["$","$L49",null,{"delay":120,"className":"FounderNote_body__tLm7s","children":[["$","p",null,{"className":"FounderNote_eyebrow__mElt2","children":"14 / Who you would be working with"}],["$","h2",null,{"className":"FounderNote_title__RY3Tz","children":"A company, not a platform"}],["$","p",null,{"className":"FounderNote_premise__Zssuz","children":"BizzFly was built on one belief: that visibility, technology and growth are a single continuous problem, and that buying them as three separate services is why most businesses solve none of them properly."}],[["$","p","That is an awkward thing to organise a company around, because it is harder to sell. It is far easier to sell a retainer for one discipline and subcontract the rest — and that handover, between the people who diagnose a problem and the people who fix it, is where most engagements quietly fail.",{"className":"FounderNote_paragraph__ymQp0","children":"That is an awkward thing to organise a company around, because it is harder to sell. It is far easier to sell a retainer for one discipline and subcontract the rest — and that handover, between the people who diagnose a problem and the people who fix it, is where most engagements quietly fail."}],["$","p","We work the other way round. The same team that finds the crawl problem capping your visibility can fix the template causing it. And if we are not the right people for what you need, we will say so and point you somewhere better.",{"className":"FounderNote_paragraph__ymQp0","children":"We work the other way round. The same team that finds the crawl problem capping your visibility can fix the template causing it. And if we are not the right people for what you need, we will say so and point you somewhere better."}]],["$","div",null,{"className":"FounderNote_actions__GYkfF","children":[["$","$L15",null,{"href":"/about-us/","className":"FounderNote_primary__ldLKp","children":["About Us",["$","span",null,{"aria-hidden":"true","children":"→"}]]}],["$","$L15",null,{"href":"/how-we-work/","className":"FounderNote_secondary__znfz9","children":"How We Work"}]]}]]}]]}]}]}]
30:["$","section",null,{"id":"faq","className":"Section_section__vCyY6 Section_lg__MMJQv is-tint","children":["$","div",null,{"className":"container container--default","children":[["$","$L49",null,{"className":"Sections_headerStack___SqEq Sections_headerCentred__w6gq_","children":[["$","div",null,{"className":"Sections_header__Q_KpY","children":[["$","p",null,{"className":"t-eyebrow","children":"15 / Questions"}],["$","h2",null,{"id":"$undefined","className":"t-h2 Sections_headerTitle__qJ_zD","children":"Asked before every first call"}]]}],["$","p",null,{"className":"t-body-lg  Sections_headerLead__EvBgC","children":"Procedural rather than technical: how this starts, how long it takes, what we will not promise, and who owns what we build."}]]}],["$","div",null,{"className":"page_faqWrap__bi4zv","children":[["$","$L65",null,{"faqs":[{"question":"What does BizzFly actually do?","answer":"Four connected things: search and AI visibility, websites and digital experience, software and automation, and the analytics that measure them. Most engagements start in one and touch a second, because visibility and the ability to serve demand are usually the same problem."},{"question":"How does an engagement start?","answer":"Almost always with a fixed-scope diagnostic rather than a retainer. It establishes which constraint is actually binding, produces a written diagnosis you keep either way, and lets both sides judge the relationship before committing further."},{"question":"How long before we see results?","answer":"Technical work can show measurable movement in indexing and impressions within about eight to twelve weeks. Content and credibility work usually takes longer to show commercially. Automation and software show a result as soon as the first process is in production, typically four to twelve weeks."},{"question":"Do you guarantee rankings or AI citations?","answer":"No, and anyone who does is describing something they do not control. What we commit to is removing the reasons a system would not rank or cite you, and reporting honestly on whether it moved."},{"question":"Who owns the code and the accounts?","answer":"You do, from the start. Code lives in your repositories and infrastructure in your accounts. Ownership arranged at the end of a project is ownership you negotiate for at the worst possible moment."},{"question":"Do you work with small businesses?","answer":"Yes, though the shape differs. Smaller engagements are usually a single focused project rather than an ongoing programme, because a programme needs enough scope each month to be worth the overhead of running one."}]}],["$","div",null,{"className":"page_sectionFooter__zSkLy","children":["$","$L15",null,{"href":"/company/faq/","className":"Button_textLink__2jONE","children":["All questions",["$","span",null,{"className":"Button_arrow__chn7G","aria-hidden":"true","children":"→"}]]}]}]]}]]}]}]
31:["$","section",null,{"id":"insights","className":"Section_section__vCyY6 Section_lg__MMJQv","children":["$","div",null,{"className":"container container--default","children":[["$","$L49",null,{"className":"Sections_headerStack___SqEq Sections_headerCentred__w6gq_","children":[["$","div",null,{"className":"Sections_header__Q_KpY","children":[["$","p",null,{"className":"t-eyebrow","children":"16 / Insights"}],["$","h2",null,{"id":"$undefined","className":"t-h2 Sections_headerTitle__qJ_zD","children":"What we have worked out, written down"}]]}],["$","p",null,{"className":"t-body-lg  Sections_headerLead__EvBgC","children":"Nothing here is gated. If content is worth reading, putting a form in front of it just means fewer people read it."}]]}],["$","div",null,{"className":"InsightGrid_grid__JcLDx","children":[["$","$L4b","/resources/what-is-generative-engine-optimisation/",{"as":"article","index":0,"className":"InsightGrid_card__CKn0R","children":[["$","div",null,{"className":"InsightGrid_frame__xQ2fF","children":["$","$L17",null,{"src":"/images/resources/resource-glossary-knowledge.webp","alt":"Authoritative digital reference library and terminology definitions for digital growth and AI","width":1200,"height":800,"loading":"lazy","sizes":"(min-width: 1100px) 380px, (min-width: 720px) 45vw, 100vw","className":"InsightGrid_image__9OIk9"}]}],["$","p",null,{"className":"InsightGrid_kind__Tu2s6","children":"glossary"}],["$","h3",null,{"className":"InsightGrid_title__PQNVV","children":["$","$L15",null,{"href":"/resources/what-is-generative-engine-optimisation/","className":"InsightGrid_titleLink__Wk__F","children":"What Is Generative Engine Optimisation?"}]}],["$","p",null,{"className":"InsightGrid_excerpt__JUqSL","children":"Generative Engine Optimisation is the practice of making a brand more likely to be cited as a source inside AI-generated answers — in systems such as ChatGPT, Perplexity, Gemini and Google AI Overviews."}],["$","p",null,{"className":"InsightGrid_action__19xJE","children":["Read more",["$","span",null,{"className":"InsightGrid_arrow__9jTbB","aria-hidden":"true","children":"→"}]]}]]}],["$","$L4b","/resources/what-is-answer-engine-optimisation/",{"as":"article","index":1,"className":"InsightGrid_card__CKn0R","children":[["$","div",null,{"className":"InsightGrid_frame__xQ2fF","children":["$","$L17",null,{"src":"/images/resources/resource-what-is-answer-engine-optimisation.webp","alt":"AI engineers and analysts working on answer engine optimisation models and semantic retrieval workflows","width":1200,"height":800,"loading":"lazy","sizes":"(min-width: 1100px) 380px, (min-width: 720px) 45vw, 100vw","className":"InsightGrid_image__9OIk9"}]}],["$","p",null,{"className":"InsightGrid_kind__Tu2s6","children":"glossary"}],["$","h3",null,{"className":"InsightGrid_title__PQNVV","children":["$","$L15",null,{"href":"/resources/what-is-answer-engine-optimisation/","className":"InsightGrid_titleLink__Wk__F","children":"What Is Answer Engine Optimisation?"}]}],["$","p",null,{"className":"InsightGrid_excerpt__JUqSL","children":"Answer Engine Optimisation is the practice of structuring content so that search and AI systems can extract it directly as the answer to a question — in featured snippets, direct answers and AI Overviews."}],["$","p",null,{"className":"InsightGrid_action__19xJE","children":["Read more",["$","span",null,{"className":"InsightGrid_arrow__9jTbB","aria-hidden":"true","children":"→"}]]}]]}],["$","$L4b","/resources/why-ai-overviews-cut-your-clicks/",{"as":"article","index":2,"className":"InsightGrid_card__CKn0R","children":[["$","div",null,{"className":"InsightGrid_frame__xQ2fF","children":["$","$L17",null,{"src":"/images/resources/resource-ai-overviews-clicks.webp","alt":"User searching on mobile device observing AI Overview summarization pushing organic links down","width":1200,"height":800,"loading":"lazy","sizes":"(min-width: 1100px) 380px, (min-width: 720px) 45vw, 100vw","className":"InsightGrid_image__9OIk9"}]