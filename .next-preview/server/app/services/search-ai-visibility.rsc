1e:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"Search & AI Visibility\",\"description\":\"Get found on Google and in AI answers. Technical SEO, AEO, GEO and entity optimisation, delivered as one programme.\",\"url\":\"https://bizzfly.com/services/search-ai-visibility/\",\"provider\":{\"@id\":\"https://bizzfly.com/#organization\"},\"areaServed\":\"IN\"}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How is AI search optimisation different from SEO?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"SEO optimises for a ranked list of links. AI search optimisation targets being used as the source inside a generated answer, which rewards clear structure, extractable definitions, and an unambiguous entity. The foundations overlap; the content shape does not.\"}},{\"@type\":\"Question\",\"name\":\"How long before we see results?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Technical fixes can show within weeks. Meaningful ranking and citation movement typically starts around week 10 to 12. Anyone promising faster is describing a different, shorter-lived tactic.\"}}]}"}}],["$","section",null,{"className":"CinematicHero_hero__r8hDz CinematicHero_bleedLeft__PRqCs is-inverse","children":[["$","div",null,{"className":"CinematicHero_media__3L0mJ","children":[["$","$L13",null,{"src":"/images/services/practice-search-ai-visibility.webp","alt":"Search visibility team reviewing multi-platform presence across Google, AI Overviews, and maps","width":1200,"height":800,"priority":true,"sizes":"100vw","className":"CinematicHero_image__VHEwa"}],["$","span",null,{"className":"CinematicHero_scrim__eiFDQ","aria-hidden":"true"}]]}],["$","div",null,{"className":"container container--default CinematicHero_container__2xIa