2d:["$","section",null,{"id":"$undefined","className":"Section_section__vCyY6 Section_lg__MMJQv","children":["$","div",null,{"className":"container container--default","children":[["$","div",null,{"className":"Sections_headerSplit__CT5lM","children":[["$","div",null,{"className":"Sections_header__Q_KpY","children":[["$","p",null,{"className":"t-eyebrow","children":"Questions"}],["$","h2",null,{"id":"$undefined","className":"t-h2","children":"Common questions"}]]}],null]}],["$","div",null,{"className":"Sections_faqList__bue3V","children":[["$","details","How is AI search optimisation different from SEO?",{"className":"Sections_faqItem__4LKLj","open":true,"children":[["$","summary",null,{"className":"Sections_faqQuestion__EmhhX","children":["How is AI search optimisation different from SEO?",["$","span",null,{"className":"Sections_faqMarker__0FJQA","aria-hidden":"true","children":"›"}]]}],["$","div",null,{"className":"Sections_faqAnswer__Z0O_5","children":["$","p",null,{"children":"SEO optimises for a ranked list of links. AI search optimisation targets being used as the source inside a generated answer, which rewards clear structure, extractable definitions, and an unambiguous entity. The foundations overlap; the content shape does not."}]}]]}],["$","details","How long before we see results?",{"className":"Sections_faqItem__4LKLj","open":false,"children":[["$","summary",null,{"className":"Sections_faqQuestion__EmhhX","children":["How long before we see results?",["$","span",null,{"className":"Sections_faqMarker__0FJQA","aria-hidden":"true","children":"›"}]]}],["$","div",null,{"className":"Sections_faqAnswer__Z0O_5","children":["$","p",null,{"children":"Technical fixes can show within weeks. Meaningful ranking and citation movement typically starts around week 10 to 12. Anyone promising faster is describing a different, shorter-lived tactic."}]}]]}]]}]]}]}]
