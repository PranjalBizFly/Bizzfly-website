1e:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Do we need a native app?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Only if you need offline use, push notifications or device hardware, and people will use it often enough to justify installing it. Otherwise a responsive web application delivers the same value without install friction or store review.\"}},{\"@type\":\"Question\",\"name\":\"Will an app help our search visibility?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No — it generally reduces it. Content inside an app is not on the web, so it cannot be crawled, ranked or cited. Anything that should be findable belongs on the site.\"}}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebPage\",\"name\":\"Mobile Platforms\",\"description\":\"Responsive web, cross-platform native, or fully native. Which capability requirements justify each route, and when an app is the wrong answer.\",\"url\":\"https://bizzfly.com/technologies/mobile-platforms/\",\"about\":{\"@id\":\"https://bizzfly.com/#organization\"}}"}}],["$","section",null,{"className":"CinematicHero_hero__r8hDz CinematicHero_inset__iJv_9 is-inverse","children":[["$","div",null,{"className":"CinematicHero_media__3L0mJ","children":[["$","$L13",null,{"src":"/images/technologies/tech-mobile-platforms.webp","alt":"Responsive viewport testing ensuring zero layout shift and touch target compliance","width":1200,"height":800,"priority":true,"sizes":"100vw","className":"CinematicHero_image__VHEwa"}],["$","span",null,{"className":"CinematicHero_scrim__eiFDQ","aria-hidden":"true"}]]}],["$","div",null,{"className":"container container--default CinematicHero_container__2xIaZ","children":[["$","div",null,{"className":"CinematicHero_breadcrumbs__bwVoY","children":[