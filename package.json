{
  "name": "bizzfly-website",
  "version": "0.1.0",
  "private": true,
  "description": "BizzFly — digital growth, AI, automation and technology.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:contrast": "node docs/design-system/verify-contrast.mjs",
    "verify:brand": "node scripts/verify-brand.mjs",
    "report:brand": "node scripts/verify-brand.mjs --report",
    "verify:images": "node --experimental-strip-types --no-warnings --import ./scripts/alias-hooks.mjs scripts/verify-image-usage.mjs",
    "verify": "npm run verify:contrast && npm run verify:brand && npm run verify:content && npm run verify:images && npm run typecheck && npm run lint",
    "verify:links": "node scripts/verify-links.mjs",
    "verify:pages": "node --experimental-strip-types --no-warnings --import ./scripts/alias-hooks.mjs scripts/verify-pages.ts",
    "verify:content": "node --experimental-strip-types --no-warnings --import ./scripts/alias-hooks.mjs scripts/verify-content.ts",
    "verify:seo": "node scripts/verify-seo.mjs",
    "verify:responsive": "node scripts/verify-responsive.mjs",
    "qa": "node scripts/qa.mjs",
    "audit:pages": "node --experimental-strip-types --no-warnings --import ./scripts/alias-hooks.mjs scripts/page-audit.ts",
    "plan:expansion": "node --experimental-strip-types --no-warnings --import ./scripts/alias-hooks.mjs scripts/expansion-plan.ts",
    "verify:rhythm": "node scripts/verify-rhythm.mjs"
  },
  "dependencies": {
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.4",
    "typescript": "^5.7.2"
  }
}
